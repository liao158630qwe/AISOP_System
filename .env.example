APP_USERNAME=admin
# Required: supply strong private passwords; never commit .env.
APP_PASSWORD=
POSTGRES_PASSWORD=
# Use the db hostname in Compose; percent-encode password characters in this URL.
DATABASE_URL=postgresql+psycopg://aisop:REPLACE_WITH_DB_PASSWORD@db:5432/aisop
# Dedicated Nginx/API network. Change both if this subnet overlaps a host/VPN network.
AISOP_PROXY_SUBNET=172.30.240.0/24
AISOP_PROXY_ADDRESS=172.30.240.10
# Included server backend. RTMO/RTMPose need additional dependencies and weights.
POSE_BACKEND=yolo
REALTIME_BACKEND=yolo
# Start with one realtime pose model copy; increase only after load testing.
# This is not a global GPU limit: screw/sticker/scene and Worker use other models.
REALTIME_POOL_SIZE=1
# Prepare models in the background before the first detection cycle.
# 后台准备人体和贴条模型，减少第一次检测等待；不生成检测记录。
REALTIME_WARMUP=true
# 实时单轮最长时长、连续无目标停止时间（秒；1–86400，不能关闭）
REALTIME_MAX_DURATION_SECONDS=600
REALTIME_NO_TARGET_SECONDS=60
# Manual workpiece registration for station 1–6 is temporarily disabled.
# Dashboard F8 detection and /terminal remain independent of registration.
PILOT_REGISTRATION_ENABLED=false
# Per-station latest-frame scheduler wait ceiling; does not create an unbounded queue.
STATION_QUEUE_WAIT_MS=500
# 1–6 active requests shared by station and generic realtime endpoints;
# effective limit also respects the shared pose pool.
STATION_INFERENCE_CONCURRENCY=1
# 1–6 lazy replicas PER specialist type (screw/sticker), sharing stream evidence.
# Same-type stations can overlap when this is >1; budget GPU memory first.
SPECIALIST_POOL_SIZE=1
# Increase only after measuring memory for the actual scene models.
# Different scene models may execute concurrently up to this cache size and
# the shared request limit; each individual model instance remains exclusive.
SCENE_MODEL_CACHE_SIZE=1
# Model execution is CUDA-only. Indices refer to GPUs visible inside the container.
INFERENCE_DEVICE=cuda:0
TRAINING_DEVICE=cuda:0
# Cap the training child's PyTorch allocator; shared-GPU capacity still needs testing.
TRAINING_GPU_MEMORY_FRACTION=0.25
# Set false on a dedicated realtime server; queued jobs wait for an enabled worker.
# Cleanup, worker heartbeat and CPU dataset extraction remain available.
WORKER_ANALYSIS_ENABLED=true
WORKER_TRAINING_ENABLED=true
# Per API/Worker process. Applied once at startup after dependency initialization.
# Use 1 on a CPU-constrained server; changing this requires a service restart.
OPENCV_THREADS=4
# CPU tensor/BLAS work per process; do not scale this to the host core count.
# Torch inter-op is fixed at one. Changes require an API/Worker restart.
TORCH_THREADS=4
# Run/upload cleanup runs in the worker; API also maintains alert archives.
CLEANUP_INTERVAL_SECONDS=3600
RUN_RETENTION_SECONDS=2592000
UPLOAD_RETENTION_SECONDS=604800
# Alert videos: hard minimum 30 days after successful archival.
EVIDENCE_RETENTION_SECONDS=2592000
# Per API/Worker process; total budget = processes * (pool + overflow).
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
DB_POOL_TIMEOUT_SECONDS=5
DB_POOL_RECYCLE_SECONDS=1800
# Maximum wait for the exclusive schema migration lock (1–600 seconds).
DB_MIGRATION_LOCK_TIMEOUT_SECONDS=60
# Production Compose enables this and lets nginx stream artifacts directly.
ARTIFACT_ACCEL_REDIRECT=false
# Upload limit in bytes. Keep nginx client_max_body_size aligned with this value.
MAX_UPLOAD_BYTES=524288000

{
  "name": "ai-sop-monitor",
  "version": "1.0.0",
  "private": true,
  "description": "AI-SOP 服务器离线视频分析平台",
  "scripts": {
    "dev": "node tools/python.cjs tools/start-local.py",
    "start": "node tools/python.cjs tools/start-local.py",
    "restart:local": "node tools/python.cjs tools/start-local.py --restart",
    "status:local": "node tools/python.cjs tools/start-local.py --status",
    "test": "node tools/python.cjs -m pytest tests -q",
    "test:login": "node tools/python.cjs -m pytest tests/test_login.py -q",
    "test:login-ui": "node tools/test-login-ui.cjs",
    "test:stability": "node tools/python.cjs tools/test-backend-stability.py",
    "test:postgres": "node tools/python.cjs tools/test-postgres-local.py",
    "test:ui": "node tools/test-screw-ui.cjs",
    "test:legacy-ui": "node tools/preview-test.cjs",
    "dev:local": "node tools/python.cjs tools/start-local.py",
    "train:screws": "node tools/python.cjs tools/train-screw-detector.py",
    "test:screw-ui": "node tools/test-screw-ui.cjs",
    "test:upload": "node tools/python.cjs tools/test-screw-upload.py",
    "test:person-ui": "node tools/test-person-task.cjs",
    "test:admin": "node --test tools/test-admin-catalog.cjs",
    "test:management": "node tools/python.cjs -m pytest tests/test_scene_management.py tests/test_scene_logic.py -q",
    "test:pilot": "node tools/python.cjs -m pytest tests/test_pilot.py tests/test_pilot_stations.py tests/test_pilot_registration.py -q",
    "test:pilot-ui": "node tools/python.cjs tools/test-pilot-ui.py",
    "test:terminals": "node tools/python.cjs -m pytest tests/test_station_terminals.py tests/test_station_tools.py -q",
    "test:collector": "node tools/python.cjs -m pytest tests/test_collector_control.py tests/test_station_collector_control.py tests/test_controlled_collection_integration.py -q",
    "test:collector-ui": "node tools/python.cjs tools/test-controlled-collection-ui.py",
    "test:station-media-ui": "node tools/python.cjs tools/test-pilot-ui.py --registration-paused --browser-script tools/test-station-media-ui.cjs",
    "test:review-recovery": "node tools/python.cjs tools/test-pilot-ui.py --registration-paused --browser-script tools/test-review-recovery.cjs",
    "test:six-video": "node tools/python.cjs -m pytest tests/test_specialist_pool.py tests/test_classifier_batch.py tests/test_screw_crop_reuse.py tests/test_station_terminals.py tests/test_station_tools.py tests/test_transport.py -q",
    "test:terminal-ui": "node tools/python.cjs tools/test-terminal-ui.py",
    "test:board-ui": "node tools/test-board-ui.cjs",
    "test:board-reset-ui": "node tools/python.cjs tools/test-pilot-ui.py --registration-paused --browser-script tools/test-board-reset-ui.cjs",
    "test:board-selected-ui": "node tools/python.cjs tools/test-pilot-ui.py --registration-paused --browser-script tools/test-board-selected-ui.cjs",
    "test:board-ranges-ui": "node tools/python.cjs tools/test-pilot-ui.py --registration-paused --browser-script tools/test-board-ranges-ui.cjs",
    "benchmark:board": "node tools/python.cjs tools/benchmark-board.py",
    "benchmark:stations": "node tools/python.cjs tools/benchmark-stations.py",
    "benchmark:stations:local": "node tools/python.cjs tools/benchmark-stations-local.py",
    "test:realtime-ui": "node tools/test-realtime-transport.cjs",
    "test:trigger-ui": "node tools/test-inspection-trigger.cjs",
    "test:main-service": "node tools/verify-main-service.cjs",
    "benchmark:service": "node tools/python.cjs tools/benchmark-service.py",
    "benchmark:storage": "node tools/python.cjs tools/benchmark-storage.py",
    "test:storage": "node tools/python.cjs -m pytest tests/test_evidence_storage.py tests/test_cleanup.py tests/test_optimization.py tests/test_postgres.py -q",
    "test:evidence-ui": "node tools/python.cjs tools/test-evidence-history.py",
    "test:management-ui": "node tools/python.cjs tools/test-scene-management.py",
    "analyze:workers": "node tools/python.cjs tools/analyze-workers.py --video assets/factory-workers.mp4 --model models/yolo11s-pose.pt --out runtime-data/cli-analysis --start 0 --end 15 --sample-fps 5 --imgsz 640",
    "test:api": "node tools/python.cjs -m pytest tests -q",
    "test:e2e": "node tools/test-screw-ui.cjs",
    "test:scene": "node tools/python.cjs -m pytest experiments/public_training/test_invariants.py experiments/public_training/test_simple_scene.py experiments/public_training/test_scene_v2.py experiments/public_training/test_evidence_filter.py experiments/public_training/test_scene_filter_v3.py experiments/public_training/test_scene_diagnostics.py -q",
    "test:scene-ui": "node tools/scene-flow-test.cjs v2.3",
    "benchmark:inference": "node tools/python.cjs tools/benchmark-inference.py",
    "server:init": "node tools/python.cjs -m backend.init_db",
    "server:start": "node tools/python.cjs -m uvicorn backend.app:create_app --factory --host 127.0.0.1 --port 8000",
    "server:worker": "node tools/python.cjs -m backend.worker",
    "server:cleanup": "node tools/python.cjs -m backend.cleanup_cli",
    "evaluate:accuracy": "node tools/python.cjs tools/evaluate-accuracy.py",
    "preview": "node tools/python.cjs tools/start-local.py",
    "preview:legacy": "node server.cjs",
    "test:datasets": "node tools/python.cjs -m pytest tests/test_datasets.py -q",
    "test:datasets-ui": "node tools/python.cjs tools/test-datasets-ui.py",
    "test:training": "node tools/python.cjs -m pytest tests/test_training_service.py tests/test_generalization.py -q",
    "test:training-ui": "node tools/python.cjs tools/test-training-ui.py",
    "test:training-interactions": "node tools/test-training-interactions.cjs",
    "test:model-import-ui": "node tools/test-model-import-ui.cjs"
  },
  "engines": {
    "node": ">=18"
  }
}
